#include<stdio.h>

void count_round(const int N, const int *d)
{
    int count = 0, result[101] = {0}, idx = 0;

    for(int i = 0; i < N; i++)
    {
        int check = 0;
        for(int j = 0; j <= idx; j++)
        {
            if(d[i] == result[j])
            {
                check = 1;
                break;   
            }
        }
        
        if(check == 0)
        {
            count++;
            idx++;
            result[idx] = d[i];
        }
    }

    printf("%d", count);
}

int main()
{
    int N, d[101];
    scanf("%d", &N);

    for(int i = 0; i < N; i++)
    {
        scanf("%d", &d[i]);
    }

    count_round(N, d);

    return 0;
}