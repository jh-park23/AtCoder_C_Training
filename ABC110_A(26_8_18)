#include<stdio.h>

int max(const int *a, const int *b, const int *c)
{
    if((*a>=*b) && (*a>=*c))
    {
        if(*b>=*c)
        {
            return ((*a * 10) + *b) + *c;
        }
        else if(*c >= *b)
        {
            return ((*a * 10) + *c) + *b;
        }
    }
    else if((*b>=*a) && (*b>=*c))
    {
        if(*a>=*c)
        {
            return ((*b * 10) + *a) + *c;
        }
        else if(*c>=*a)
        {
            return ((*b * 10) + *c) + *a;
        }
    }
    else if((*c>=*a) && (*c>=*b))
    {
        if(*a>=*b)
        {
            return ((*c * 10) + *a) + *b;
        }
        else if(*b>=*a)
        {
            return ((*c * 10) + *b) + *a;
        }
    }
}

int main()
{
    int A, B, C;
    scanf("%d %d %d", &A, &B, &C);

    printf("%d", max(&A, &B, &C));

    return 0;
}