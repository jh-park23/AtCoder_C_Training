#include<stdio.h>

void count_method(const int A, const int B, const int C, int X)
{
    int count = 0;
    
    for(int i = 0; i <= A; i++)
    {
       for(int j = 0; j <= B; j++)
       {
            for(int k = 0; k <= C; k++)
            {
                if(500*i + 100*j + 50*k == X)
                {
                    count++;
                }
            }
       }
    }

    printf("%d", count);
}

int main()
{
    int A, B, C, X;
    scanf("%d %d %d", &A, &B, &C);
    scanf("%d", &X);

    count_method(A, B, C, X);

    return 0;
}