#include<stdio.h>

void measure_snow(const int a, const int b)
{
    int tower[1000];

    for(int i = 1; i <= 999; i++)
    {
        tower[i-1] = (i*(i+1))/2;
    }
    
    for(int i = 0; i < 998; i++)
    {
        if(a < tower[i] && b < tower[i+1])
        {
            if((tower[i]-a) == (tower[i+1]-b))
            {
                printf("%d\n", tower[i]-a);
                return;
            }
        }
    }
}


int main()
{
    int a, b;
    scanf("%d %d", &a, &b);

    measure_snow(a, b);

    return 0;
}