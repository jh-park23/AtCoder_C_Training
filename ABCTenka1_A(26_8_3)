#include<stdio.h>

int main()
{
    char S[6];
    int accepted = 0;
    scanf("%s", S);
    
    for(int i =0; i<6; i++)
    {
        if(S[i]=='1')
        {
            accepted++;
        }
        else if(S[i]=='0')
        {
            continue;
        }
    }

    printf("%d", accepted);
    return 0;
}