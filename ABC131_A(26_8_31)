#include<stdio.h>

int check_security(const char *S)
{
    int i = 0, compare_idx = i + 1;
    int consecutive = 0;

    for(i; i < 3; i++)
    {    
        if(S[i] == S[compare_idx])
        {
            consecutive = 1;
            goto bad;    
        }
        else if(S[i] != S[compare_idx])
        {
            consecutive = 0;
        }

        compare_idx++;
    }

    bad: ;

    if(consecutive == 1)
    {
        return 0;
    }
    else if(consecutive == 0)
    {
        return 1;
    }
}

int main()
{
    char S[5];
    scanf("%s", S);


    if(check_security(S) == 1)
    {
        printf("Good\n");
    }
    else if(check_security(S) == 0)
    {
        printf("Bad\n");
    }

    return 0;
}