#include<stdio.h>

int main()
{
    char S[5];
    scanf("%s", S);

    int count_p=0, count_m=0;

    for(int i = 0; i < 4; i++)
    {
        if(S[i]=='+')
        {
            count_p ++;
        }
        else if(S[i]=='-')
        {
            count_m ++;
        }
    }

    printf("%d", count_p-count_m);

    return 0;
}