#include<stdio.h>
#include<string.h>

void most_earn(const int N, const int M, const char s[101][11], const char t[101][11])
{
    int max_count = 0;

    for(int i = 0; i < N; i++)
    {
        int count = 0;

        for(int j = 0; j < N; j++)
        {
            if(strcmp(s[i],s[j]) == 0)
            {
                count++;
            }
        }

        for(int j = 0; j < M; j++)
        {
            if(strcmp(s[i], t[j]) == 0)
            {
                count--;
            }
        }

        if(max_count < count)
        {
            max_count = count;
        }
    }

    printf("%d\n", max_count);

}

int main()
{
    int N, M;
    char s[101][11], t[101][11];
    
    scanf("%d", &N);
    for(int i = 0; i < N; i++)
    {
        scanf("%s", s[i]);
    }

    scanf("%d", &M);
    for(int i = 0; i < M; i++)
    {
        scanf("%s", t[i]);
    }

    most_earn(N, M, s, t);

    return 0;
}