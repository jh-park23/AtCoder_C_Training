#include<stdio.h>

void calc_total(const int N, int *a)
{
    int total = 0, Alice = 0, Bob = 0, largest = 0, optimal = 0, idx =0,  check = 0;

    while(check != N)
    {
        check = 0;
        for(int i = 0; i < N; i++)
        {
            if(a[i] > largest)
            {
                largest = a[i];
                idx = i;
            }
        }

        a[idx] = 0;

        for(int i = 0; i < N; i++)
        {
            if(a[i] <= largest && optimal < a[i])
            {
                optimal = a[i];
                idx = i; 
            }
        }

        a[idx] = 0;

        Alice += largest;
        Bob += optimal;

        largest = 0;
        optimal = 0;

        for(int i = 0; i < N; i++)
        {
            if(a[i] == 0)
            {
                check++;
            }
        }
    }

    total = Alice - Bob;
    printf("%d", total);

}

int main()
{
    int N, a[101];
    scanf("%d", &N);
    for(int i = 0; i < N; i++)
    {
        scanf("%d", &a[i]);
    }

    calc_total(N, a);

    return 0;
}