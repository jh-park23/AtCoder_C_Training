#include<stdio.h>

void picture_frame(const int *a, const int *b, const char P[][103])
{
    char result[103][103];

    for(int i = 0; i < *a+2; i++)
    {
        result[i][0] = '#'; 
        result[i][*b+1] = '#';
        result[i][*b+2] = '\0';
    }
    for(int i = 1; i < *b+2; i++)
    {
        result[0][i] = '#';
        result[*a+1][i] = '#';
    }

    for(int i = 0; i < *a; i++)
    {
        for(int j = 0; j < *b; j++)
        {
            int idx_H, idx_W;

            idx_H = i+1;
            idx_W = j+1;

            result[idx_H][idx_W] = P[i][j];
        }
    }

    for(int i = 0; i < *a + 2; i++)
    {
        printf("%s\n", result[i]);
    }
}

int main()
{
    int H, W;
    char P[103][103];
    scanf("%d %d", &H, &W);

    for(int i = 0; i < H; i++)
    {
        scanf("%s", P[i]);
    }

    picture_frame(&H, &W, P);

    return 0;
}