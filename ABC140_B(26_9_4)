#include<stdio.h>

void cal_point(const int *n, const int *a, const int *b, const int *c)
{
    int total_point = 0;

    for(int i = 0; i < *n; i++)
    {
        if(i >= 1)
        {
            int past_idx = i - 1, gap = a[i] - a[past_idx];

            if(gap == 1)
            {
                total_point += b[a[i] - 1];
                total_point += c[a[past_idx] - 1];
            }
            else
            {
               total_point += b[a[i] - 1]; 
            }
        }
        else
        {
            total_point += b[a[i] - 1];
        }
    }

    printf("%d\n", total_point);
}

int main()
{
    int N, A[21], B[21], C[21];
    scanf("%d", &N);
    for(int i = 0; i < N; i++)
    {
        scanf("%d", &A[i]);
    }
    for(int i = 0; i < N; i++)
    {
        scanf("%d", &B[i]);
    }
    for(int i = 0; i < N-1; i++)
    {
        scanf("%d", &C[i]);
    }
    

    cal_point(&N, A, B, C);

    return 0;
}