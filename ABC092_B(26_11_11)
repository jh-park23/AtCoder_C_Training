#include<stdio.h>

void num_chocolate(const int N, const int D, const int X, const int *A)
{
    int total = X;

    for(int i = 0; i < N; i++)
    {
        for(int j = 0; A[i]*j + 1 <= D; j++)
        {
            total++;
        }
    }

    printf("%d\n", total);
}

int main()
{
    int N, D, X, A[101];
    scanf("%d", &N);
    scanf("%d %d", &D, &X);

    for(int i = 0; i < N; i++)
    {
        scanf("%d", &A[i]);
    }

    num_chocolate(N, D, X, A);

    return 0;
}