#include<stdio.h>

void time_calculator(const int *a, int *b, const int *c, const int d[][3])
{
    for(int i = 0; i < *c; i++)
    {
        int total_time = 0;

        int idx = d[i][0] - 1, temp = b[idx];
        b[idx] = d[i][1];

        for(int j = 0; j < *a; j++)
        {
            total_time += b[j];
        }

        printf("%d\n", total_time);
        
        b[idx] = temp;
    }
}

int main()
{
    int N, T[101], M, PX[101][3];
    scanf("%d", &N);
    
    for(int i = 0; i < N; i++)
    {
        scanf("%d", &T[i]);
    }

    scanf("%d", &M);

    for(int i = 0; i < M; i++)
    {
        scanf("%d %d", &PX[i][0], &PX[i][1]);
    }

    time_calculator(&N, T, &M, PX);

    return 0;
}