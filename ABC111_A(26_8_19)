#include<stdio.h>

char * replace_S(char *a)
{
    for(int i = 0; i <3; i++)
    {
        if(a[i] == '1')
        {
            a[i] = '9';
        }
        else if(a[i] == '9')
        {
            a[i] = '1';
        }
    }
    
    return a;
}

int main()
{
    char S[4];
    scanf("%s", S);

    printf("%s", replace_S(S));

    return 0;
}