#include<stdio.h>

void find_K(const int K, const int A, const int B)
{
    int check = 0;
    for(int i = A; i <= B; i++)
    {
        if(i % K == 0)
        {
            check = 1;
        }

        if(check == 1)
        {
            printf("OK");
            break;
        }
    }

    if(check == 0)
    {
        printf("NG");
    }
}

int main()
{
    int K, A, B;
    scanf("%d", &K);
    scanf("%d %d", &A, &B);

    find_K(K, A, B);

    return 0;
}