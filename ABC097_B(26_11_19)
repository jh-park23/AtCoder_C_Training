#include<stdio.h>

void find_pow(const int X)
{
    long long largest = 1;
    
    for(int b = 2; b*b <= X; b++)
    {
        long long value = (long long)b*b;
        
        while(value <= X)
        {
            if(largest < value)
            {
                largest = value;
            }
            value *= b;       
        }

        
    }

    printf("%lld\n", largest);
}

int main()
{
    int X;
    scanf("%d", &X);

    find_pow(X);

    return 0;
}