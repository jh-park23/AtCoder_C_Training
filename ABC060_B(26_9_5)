#include<stdio.h>

void objective_achievable(const int *a, const int *b, const int *c)
{
    int achievable = 0;

    for(int i = 1; i <= *b; i++)
    {
        if(*a * i % *b == *c)
        {
            achievable = 1;
            break;
        }
    }

    if(achievable == 1)
    {
        printf("YES\n");
    }
    else if(achievable == 0)
    {
        printf("NO\n");
    }
}

int main()
{
    int A, B, C;
    scanf("%d %d %d", &A, &B, &C);

    objective_achievable(&A, &B, &C);

    return 0;
}