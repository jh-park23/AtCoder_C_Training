#include<stdio.h>
#include<string.h>
#include<ctype.h>

void multi_HEIGHT(const int * a, const char S[][101], char result[][101])
{
    for(int i = 0; i < *a; i++)
    {
        strcpy(result[2*i], S[i]);
        strcpy(result[2*i+1], S[i]); 
    }
}

int main()
{
    int H, W;
    scanf("%d %d", &H, &W);

    char S[100][101], result[200][101];

    for(int i = 0; i < H; i++)
    {
        scanf("%s", S[i]);
    }

    multi_HEIGHT(&H, S, result);

    for(int i = 0; i < 2*H; i++)
    {
        printf("%s\n", result[i]);
    }

    return 0;
}