#include<stdio.h>

void check_squarenum(const int a, const int b)
{
    int num = 0, check = 0;
    if(b >= 1 && b <= 9)
    {
        num = a*10 + b;   
    }
    else if(b >= 10 && b <= 99)
    {
        num = a*100 + b;
    }
    else num = a*1000 + b;

    for(int i = 0; i*i <= num; i++)
    {
        if(i*i == num)
        {
            check = 1;
            break;
        } 
    }

    if(check == 1)
    {
        printf("Yes");
    }
    else printf("No");
}

int main()
{
    int a, b;
    scanf("%d %d", &a, &b);

    check_squarenum(a, b);

    return 0;
}