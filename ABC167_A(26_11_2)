#include<stdio.h>

void check_T(const char *S, const char *T)
{
    int check = 0, i = 0;
    for(i; S[i] != '\0'; i++)
    {
        if(S[i] != T[i])
        {
            check = 1;
            break;
        }
    }

    if(check == 1)
    {
        printf("No");
    }
    else if(check == 0)
    {
        if(S[i] == '\0' && ('a' <= T[i]  && 'z' >= T[i]) && T[i+1] == '\0')
        {
            printf("Yes");
        }
        else printf("No");
    }
}

int main()
{
    char S[11], T[11];
    scanf("%s %s", S, T);

    check_T(S, T);

    return 0;
}