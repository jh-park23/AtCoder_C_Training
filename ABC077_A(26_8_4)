#include<stdio.h>

int main()
{
    char C[2][4];
    scanf("%s %s", C[0], C[1]);
    int count=0;

    for(int i=0; i<3; i++)
    {
        if(C[0][i]==C[1][2-i])
        {
            count++;
        }
        else
        {
            continue;
        }
    
    }

    if(count==3)
    {
        printf("YES");
    }
    else
    {
        printf("NO");
    }

    return 0;
}
