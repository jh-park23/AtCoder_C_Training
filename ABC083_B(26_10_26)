#include<stdio.h>

void find_sum(const int N, const int A, const int B)
{
    int sum = 0;

    for(int i = 1; i <= N; i++)
    {
        int find_sum = 0, next = i;

        while(next > 0)
        {
            find_sum += next % 10;
            next = next / 10;
        };

        if(A <= find_sum && find_sum <= B)
        {
            sum += i;
        }
    }

    printf("%d", sum);
}

int main()
{
    int N, A, B;
    scanf("%d %d %d", &N, &A, &B);

    find_sum(N, A, B);

    return 0;
}

