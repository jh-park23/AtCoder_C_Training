#include<stdio.h>
#include<stdlib.h>
#include<math.h>

int white_region(const int *a, const int *b, const int * c, const int S[][3])
{
    int total_white;
    int small_than_x =0, large_than_x = *a, small_than_y = 0, large_than_y = *b;

    for(int i = 0; i < *c; i++)
    {
        if(S[i][2] == 1)
        {
            if(small_than_x < S[i][0])
            {
                small_than_x = S[i][0];
            }
        }
        else if(S[i][2] == 2)
        {
            if(large_than_x > S[i][0])
            {
                large_than_x = S[i][0];
            }
        }
        else if(S[i][2] == 3)
        {
            if(small_than_y < S[i][1])
            {
                small_than_y = S[i][1];
            }
        }
        else if(S[i][2] == 4)
        {
            if(large_than_y > S[i][1])
            {
                large_than_y = S[i][1];
            }
        }
    }

    if((small_than_x<large_than_x)&&(small_than_y<large_than_y))
    {
        total_white = abs(large_than_x - small_than_x) * (large_than_y - small_than_y);
    }
    else
    {
        total_white = 0;
    }

    return total_white;

}

int main()
{
    int W, H, N;
    int S[100][3];
    scanf("%d %d %d", &W, &H, &N);
    
    for(int i = 0; i < N; i++)
    {
        scanf("%d %d %d", &S[i][0], &S[i][1], &S[i][2]);
    }

    printf("%d", white_region(&W, &H, &N, S));

    return 0;
}