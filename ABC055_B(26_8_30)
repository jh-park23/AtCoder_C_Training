#include<stdio.h>

long long total_power(const int *a)
{
    long long power = 1;

    for(int i = 0; i < *a; i++)
    {
        power = (power * (i+1)) % 1000000007;
    }

    return power;
}

int main()
{
    int N;
    scanf("%d", &N);

    printf("%lld\n", total_power(&N));
    
    return 0;
}