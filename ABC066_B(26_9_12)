#include<stdio.h>
#include<string.h>

void find_even(char *a)
{
    int len = strlen(a), inital_len = strlen(a);
    
    while(len > 1)
    {
        if(len % 2 == 0 && len < inital_len)
        {
            for(int i = 0; i < len / 2; i++)
            {
                if(a[i] != a[(len / 2) + i])
                {
                    goto fail;
                }
            }

            printf("%d\n", len);
            return;
        
        }
        fail: ;
        a[len -1] = '\0';
        len--; 
    }
}

int main()
{
    char S[201];
    scanf("%s", S);

    find_even(S);

    return 0;
}