#include<stdio.h>

void cost(const int * a, const int * b)
{
    if(*a>=13)
    {
        printf("%d\n", *b);
    }
    else if(6<=*a && *a<=12)
    {
        printf("%d\n", *b/2);
    }
    else if(*a<=5)
    {
        printf("%d\n", 0);
    }
}

int main()
{
    int A, B;
    scanf("%d %d", &A, &B);

    cost(&A, &B);

    return 0;
}