#include<stdio.h>

void wrong_num(const int *a, const int *b)
{
    if(*a == 1)
    {
        if(*b == 2)
        {
            printf("3\n");
        }
        else if(*b == 3)
        {
            printf("2\n");
        
        }
    }
    else if(*a == 2)
    {
        if(*b == 1)
        {
            printf("3\n");
        }
        else if(*b == 3)
        {
            printf("1\n");
        }   
    }
    else if(*a == 3)
    {
        if(*b == 1)
        {
            printf("2\n");
        }
        else if(*b == 2)
        {
            printf("1\n");
        }   
    }
    
}

int main()
{
    int A, B;
    scanf("%d %d", &A, &B);

    wrong_num(&A, &B);

    return 0;
}